/* Theme roles. --night remains the foreground on solid signal green. */
:root {
  --hero-surface: #dce9ef;
  --footer-surface: #d9e6ed;
  --panel-surface: #f8fbfc;
  --panel-raised: #e4eef4;
  --control-surface: #fff;
  --control-line: #718896;
  --control-hover: #dce9ef;
  --selection-surface: #d7ff47;
  --selection-ink: #071d2d;
  --action-ink: #24614e;
  --focus-outline: #973c26;
  --error-ink: #9f2e1b;
  --notice-surface: #ffe3a0;
  --notice-ink: #382b0b;
  --notice-line: #8a641d;
  --rail: #a4b8c4;
  --mint-surface: #daf1e9;
  --lime-surface: #e8efc9;
  --blue-surface: #dce8fa;
  --amber-surface: #f7ecd2;
  --neutral-surface: #e5edf2;
  --dialog-scrim: #071d2d9e;
}

html[data-theme="dark"] {
  color-scheme: dark;
  --ink: #edf4f7;
  --soft: #b1c5d0;
  --paper: #0b1b27;
  --deep: #152d3b;
  --card: #102532;
  --line: #456171;
  --green: #a9dfc8;
  --placeholder: #a6bfcd;
  --hero-surface: #101f2b;
  --footer-surface: #081722;
  --panel-surface: #132e3e;
  --panel-raised: #19384a;
  --control-surface: #0c202d;
  --control-line: #7893a2;
  --control-hover: #234354;
  --action-ink: #bde491;
  --focus-outline: #ffab96;
  --error-ink: #ffab96;
  --notice-surface: #3d321a;
  --notice-ink: #ffe3a0;
  --notice-line: #b99c56;
  --rail: #65808f;
  --mint-surface: #193b39;
  --lime-surface: #303c24;
  --blue-surface: #203751;
  --amber-surface: #3d3324;
  --neutral-surface: #233541;
  --dialog-scrim: #040b12cc;
}

html { background: var(--paper); }
:focus-visible { outline-color: var(--focus-outline); }
::-webkit-scrollbar-thumb { background: var(--control-line); }
.hero, .page-hero { color: var(--ink); background: var(--hero-surface); }
.hero:after, .page-hero:after { height: 2px; background: var(--line); }
.hero h1 span, .breadcrumb { color: var(--action-ink); }
.hero .lede, .page-hero .lede { color: var(--soft); }

.top-note, .site-footer { color: var(--ink); background: var(--footer-surface); }
.top-note a, .footer-title { color: var(--action-ink); }
.site-footer .brand { color: var(--ink); }
.site-footer .brand-copy small, .footer-copy, .footer-links a, .footer-bottom { color: var(--soft); }
.footer-bottom { border-color: var(--line); }

.dark-section, .guide-intro, .focus-timer-card, .compare-dock {
  color: var(--ink);
  background: var(--panel-surface);
}
.focus-timer-card, .compare-dock, .guide-intro { border: 1px solid var(--line); }
.dark-section .section-header p, .guide-intro p, .focus-timer-card .section-label,
.timer-task, .focus-status, .distraction-button, .distraction-count { color: var(--soft); }
.timer-core { color: var(--ink); background: var(--panel-raised); border-color: var(--line); }
.timer-label { color: var(--action-ink); }
.timer-ring:before, .progress, .today-bar { background: var(--rail); }
.timer-ring:after { width: calc(var(--timer-progress) * .8); background: var(--action-ink); }
.session-row .session-status { color: var(--ink); }
.session-row .session-status.is-complete, .match-score, .step-list li:before { color: var(--selection-ink); }

.bg-mint, .safety-card:nth-child(even) { background: var(--mint-surface); }
.bg-lime, .guide-card:nth-child(2) { background: var(--lime-surface); }
.bg-blue, .guide-card:nth-child(3) { background: var(--blue-surface); }
.bg-amber { background: var(--amber-surface); }
.bg-lavender { background: var(--neutral-surface); }
.problem-grid, .problem-card, .feature-grid, .feature-card { border-color: var(--line); }
.problem-card, .guide-card:nth-child(n), .safety-card:nth-child(n) { color: var(--ink); }
.guide-card, .safety-card:nth-child(odd) { background-color: var(--card); }
.guide-card, .safety-card { border: 1px solid var(--line); }
.guide-card p, .feature-card p, .safety-card:nth-child(n) .section-label { color: var(--soft); }
.feature-number { color: var(--action-ink); }
.problem-card:hover { color: var(--ink); background: var(--control-hover); }

.field, .select-field, textarea, .theme-toggle {
  color: var(--ink);
  background: var(--control-surface);
  border-color: var(--control-line);
}
button, input, select, textarea { accent-color: var(--action-ink); }
.field:focus, .select-field:focus, textarea:focus { outline-color: var(--focus-outline); border-color: var(--focus-outline); }
.field-error, [data-form-error], .form-card [data-field-error]:not(:empty) { color: var(--error-ink); }
.field[aria-invalid="true"], .select-field[aria-invalid="true"] { border-color: var(--error-ink); }
.notice, .callout { color: var(--notice-ink); background: var(--notice-surface); }
.btn-secondary, .hero .btn-secondary, .timer-controls .btn-secondary,
.icon-btn, .duration-chip, .menu-toggle, .modal-close, .main-nav .nav-cta {
  color: var(--ink);
  border-color: var(--control-line);
}
.btn-secondary:hover, .hero .btn-secondary:hover, .timer-controls .btn-secondary:hover,
.icon-btn:hover, .menu-toggle:hover, .modal-close:hover, .theme-toggle:hover, .duration-chip:hover {
  color: var(--ink);
  background: var(--control-hover);
  border-color: var(--control-line);
