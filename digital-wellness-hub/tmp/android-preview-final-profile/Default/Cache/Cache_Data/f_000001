  background: var(--selection-surface);
  border-color: var(--selection-surface);
}
.main-nav a:hover { color: var(--ink); background: var(--control-hover); }
.main-nav a:is([aria-current="page"], .is-active) {
  color: var(--selection-ink);
  background: var(--selection-surface);
}

.compare-modal { background: var(--dialog-scrim); }
.modal-card { border: 1px solid var(--control-line); }
.compare-table th { color: var(--ink); background: var(--panel-raised); }
[data-open-compare][style] {
  color: var(--selection-ink) !important;
  background: var(--selection-surface) !important;
