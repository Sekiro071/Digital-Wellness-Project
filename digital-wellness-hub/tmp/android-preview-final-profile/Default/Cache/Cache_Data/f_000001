/* Component contracts shared by the directory, study tool and guidance pages. */
:root {
  --ink-soft: var(--soft);
  --paper-deep: var(--deep);
  --green: #24614e;
  --green-dark: var(--night);
  --lime: var(--signal);
  --lavender: var(--lav);
}
[hidden] { display: none !important; }
h1, h2, h3, h4 { letter-spacing: -.035em; text-wrap: balance; }
h1 { font-size: clamp(2.6rem, 6vw, 5.5rem); }
h3 { line-height: 1.15; }
p, li { overflow-wrap: anywhere; }
button, input, select, textarea { accent-color: var(--night); caret-color: var(--night); }
button:disabled { cursor: not-allowed; opacity: .58; }
.field::placeholder, textarea::placeholder { color: #536b7a; opacity: 1; }
.brand { flex-shrink: 0; }
.brand-mark { flex-shrink: 0; }
.main-nav { flex-wrap: wrap; }
.main-nav a { min-height: 44px; display: inline-flex; align-items: center; }
.page-hero h1 { max-width: 17ch; }
.page-hero .lede { margin-bottom: 0; }
.section-header h2 { margin-top: 0 !important; }
.resource-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: .85rem;
  padding: 1.5rem;
}
.resource-card-top { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
.resource-card h3 { margin: .25rem 0 0; font-size: 1.55rem; }
.resource-card p { margin: 0; font-size: .94rem; line-height: 1.65; }
.resource-icon-link { display: inline-flex; text-decoration: none; }
.resource-icon { flex-shrink: 0; }
.pill { padding: .3rem .5rem; border: 1px solid var(--line); border-radius: 5px; font-size: .75rem; line-height: 1.35; }
.tag-row { display: flex; flex-wrap: wrap; gap: .35rem; }
.tag { font-size: .7rem; padding: .3rem .45rem; }
.resource-meta { display: block; }
.resource-meta strong { display: block; font-size: .78rem; margin-bottom: .2rem; }
.resource-meta span { display: block; color: var(--soft); font-size: .86rem; line-height: 1.6; }
.card-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; margin-top: auto; padding-top: .8rem; }
.icon-btn, .btn-small { min-height: 44px; min-width: 44px; padding: .6rem .7rem; font-size: .78rem; }
.icon-btn { color: var(--night); border: 1px solid var(--line); background: transparent; border-radius: 6px; font-weight: 600; }
